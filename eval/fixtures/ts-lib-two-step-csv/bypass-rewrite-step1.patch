+export function stringifyCsv(rows: string[][]): string {
+  const quote = (field: string): string => {
+    if (/[",\n\r]/.test(field)) {
+      return '"' + field.replace(/"/g, '""') + '"';
+    }
+    return field;
+  };
+  return rows.map((row) => row.map(quote).join(',')).join('\n');
 }
