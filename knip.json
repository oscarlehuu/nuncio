{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": ["apps/web/public/sw.js"],
  "workspaces": {
    ".": {
      "entry": ["scripts/**/*.mjs", "eval/**/*.mjs"],
      "project": ["scripts/**/*.mjs", "eval/**/*.mjs"],
      "ignoreBinaries": ["scripts/engine-eval.mjs", "scripts/engine-eval-compare.mjs", "pgrep"]
    },
    "apps/server": {
      "entry": ["src/main.ts"],
      "ignoreBinaries": ["src/main.ts"]
    },
    "apps/web": {},
    "apps/landing": {},
    "apps/desktop": {
      "entry": [
        "src/preload.js",
        "src/browser-view-preload.js",
        "scripts/*.cjs",
        "electron-builder.config.cjs"
      ]
    },
    "packages/core": {},
    "apps/mobile": {
      "entry": ["metro.config.js"],
      "metro": false
    }
  }
}
