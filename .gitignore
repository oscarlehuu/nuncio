# Screenshots (kept locally, not in repo) — except in assets/, web public icons,
# and desktop build assets (tray/menu-bar icons ship with the packaged app)
*.jpg
*.png
!assets/*.jpg
!assets/*.png
!apps/web/public/**/*.png
!apps/desktop/build/*.png

# Real-browser smoke artifacts (screenshots + failure traces; CI uploads them)
smoke-artifacts/

# OS
.DS_Store
Thumbs.db

# Node
node_modules/
dist/
coverage/
build-resources/
data/
.pi/
.env
.env.local

# Editor
.vscode/
.idea/
*.swp
*.swo

# Agent / IDE run state (machine- and session-specific, not source)
.claude/
.cursor/hooks/state/

# Behavioral eval reports (generated per run; suite/fixtures/checks are source)
eval/reports/
