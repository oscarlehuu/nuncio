{
  "name": "@nuncio/desktop",
  "version": "0.2.0",
  "private": true,
  "description": "Nuncio desktop shell — Electron window that supervises the Bun/Nest daemon and loads the single-port UI.",
  "main": "src/main.js",
  "scripts": {
    "dev": "electron .",
    "test": "bun test",
    "lint": "oxlint src test scripts",
    "postinstall": "electron-rebuild -w node-pty",
    "rebuild": "electron-rebuild -w node-pty",
    "build:resources": "bun scripts/build-resources.mjs",
    "smoke": "bun scripts/smoke-desktop.mjs",
    "dist": "bun run build:resources && electron-builder --config electron-builder.config.cjs",
    "dist:stable": "NUNCIO_CHANNEL=stable bun run dist",
    "dist:dev": "NUNCIO_CHANNEL=dev bun run dist"
  },
  "devDependencies": {
    "@electron/notarize": "^3.0.1",
    "@electron/rebuild": "^4.1.0",
    "electron": "^42.5.2",
    "electron-builder": "^26.0.12",
    "oxlint": "^1.69.0"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "node-pty": "^1.1.0"
  }
}
