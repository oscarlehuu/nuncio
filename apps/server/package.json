{
  "name": "@nuncio/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "bun ../../scripts/run-server.mjs --watch",
    "mcp": "bun src/mcp-stdio/main.ts",
    "start": "bun ../../scripts/run-server.mjs",
    "start:prod": "bun run dist/main.js",
    "test": "bun test test/unit/",
    "test:e2e": "bun test ./test/e2e/app.e2e-spec.ts ./test/e2e/crew.e2e-spec.ts",
    "test:integration": "bun test test/integration/",
    "test:integration:codex": "NUNCIO_CODEX_INTEGRATION=1 bun test test/integration/codex-agent.integration.spec.ts",
    "test:integration:claude": "NUNCIO_CLAUDE_INTEGRATION=1 bun test test/integration/claude-agent.integration.spec.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.201",
    "@cursor/sdk": "^1.0.22",
    "@earendil-works/pi-coding-agent": "^0.80.6",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "express": "5.2.1",
    "expo-server-sdk": "^6.1.0",
    "playwright-core": "^1.61.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^11.1.0",
    "ws": "^8.21.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bun": "^1.3.14",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
